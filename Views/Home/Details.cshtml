@model MVC_1.Models.Movie

@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-4">
        <img src="~/images/posters/@Model.PosterFileName" class="img-fluid rounded" alt="@Model.Title" />
    </div>
    <div class="col-md-8">
        <h1>@Model.Title (@Model.Year)</h1>
        <dl class="row mt-3">
            <dt class="col-sm-3">Режисер</dt>
            <dd class="col-sm-9">@Model.Director</dd>

            <dt class="col-sm-3">Жанр</dt>
            <dd class="col-sm-9">@Model.Genre</dd>

            <dt class="col-sm-3">Опис</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Видалити</a>
            <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
        </div>
    </div>
</div>

@model List<MVC_1.Models.Movie>

@{
    ViewData["Title"] = "Топ 10 фільмів";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Топ 10 фільмів</h1>
    <a asp-action="Create" class="btn btn-success">Додати фільм</a>
</div>

<div class="row">
    @foreach (var movie in Model)
    {
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(movie.PosterFileName))
                {
                    <img src="~/images/posters/@movie.PosterFileName" class="card-img-top" alt="@movie.Title" style="height:350px; object-fit:cover;" />
                }
                else
                {
                    <div class="card-img-top bg-secondary-subtle d-flex align-items-center justify-content-center text-muted" style="height:350px;">Без постера</div>
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@movie.Title (@movie.Year)</h5>
                    <p class="card-text mb-1"><strong>Режисер:</strong> @movie.Director</p>
                    <p class="card-text mb-1"><strong>Жанр:</strong> @movie.Genre</p>
                    <div class="mt-auto pt-2 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-primary btn-sm">Деталі</a>
                        <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-warning btn-sm">Редагувати</a>
                        <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-outline-danger btn-sm">Видалити</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
